# Copy this file to .env and adjust if needed.

# SQLite database file (local, persists your conversations/progress on disk).
DATABASE_URL="file:./dev.db"

# Local LLM server, OpenAI-compatible chat completions API.
# Default matches LM Studio's local server (Developer tab -> Start Server).
LLM_BASE_URL="http://localhost:1234/v1"

# Model identifier as loaded in LM Studio (see the model name in its UI/API).
# A coding-capable model is recommended, e.g. a Qwen2.5-Coder or DeepSeek-Coder variant.
LLM_MODEL="qwen2.5-coder-7b-instruct"
